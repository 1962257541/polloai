# Core
NODE_ENV=development
APP_PORT=3001
WEB_PORT=3000
CORS_ORIGINS=*

# Database
DATABASE_URL=postgresql://polloai:polloai@localhost:5432/polloai?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=polloai-media
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/polloai-media

# Auth
JWT_SECRET=change_me_in_prod
JWT_EXPIRES_IN=7d

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
HTTPS_PROXY=
HTTP_PROXY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GEMINI_VIDEO_SECONDS=4
GEMINI_VIDEO_RESOLUTION=720p

# Credits
IMAGE_COST=2
VIDEO_COST=20
