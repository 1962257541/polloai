# Core
NODE_ENV=development
APP_PORT=3001
WEB_PORT=3000
CORS_ORIGINS=*

# Database
DATABASE_URL=postgresql://polloai:polloai@localhost:5432/polloai?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=polloai-media
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/polloai-media

# Auth
JWT_SECRET=change_me_in_prod
JWT_EXPIRES_IN=7d

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
HTTPS_PROXY=
HTTP_PROXY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GEMINI_VIDEO_SECONDS=5
GEMINI_VIDEO_RESOLUTION=720p

# 火山引擎 AI MediaKit 视频画质增强 —— 用于"画质提升"功能
# 优先级：系统设置(DB) > 此处 env > 默认值；未配置 API Key 时画质提升任务会明确失败提示
# 推荐在「系统设置 → 画质提升」界面维护，无需重启 worker
VOLC_API_KEY=
VOLC_HOST=mediakit.cn-beijing.volces.com
# 工具版本 standard（标准版）/ professional（专业版）
VOLC_TOOL_VERSION=standard
# 默认目标分辨率 240p~4k；留空表示使用原始分辨率
VOLC_RESOLUTION=

# Credits
IMAGE_COST=2
VIDEO_COST=20

# TikTok Public Profile Monitor (v2)
# 采集 TikTok 公开账号数据，无需 cookie/登录态
TIKTOK_SCRAPER_HEADLESS=true
# 代理（国内环境必填，直连 tiktok.com 不通；常用：socks5://127.0.0.1:7890）
# 不配则 fallback 到 all_proxy / ALL_PROXY / HTTPS_PROXY 环境变量
TIKTOK_SCRAPER_PROXY=
# Playwright 浏览器池大小（每个槽位一个 context，默认 5）
TIKTOK_SCRAPER_POOL_SIZE=5
# 单次抓取超时 ms（默认 90000）
TIKTOK_SCRAPER_TIMEOUT_MS=90000
