generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationType {
  text_to_image
  image_to_video
  video_upscale
}

enum TaskStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum AssetRole {
  input
  output
}

enum MediaType {
  image
  video
}

enum UserRole {
  admin
  salesperson
}

enum MaterialSource {
  uploaded
  generated
}

enum TiktokAccountStatus {
  active
  not_found
  rate_limited
  error
  disabled
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  name         String?
  passwordHash String
  role         UserRole         @default(salesperson)
  apiKey       String?
  apiUrl       String?
  imageModel   String?
  imageModels  String[]         @default([])
  imageApiType String?          @default("openai-images")
  videoModel   String?
  videoModels  String[]         @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tasks          GenerationTask[]
  auditLogs      ApiAuditLog[]
  materials      Material[]
  tiktokAccounts TiktokAccount[]
}

model Material {
  id         String         @id @default(uuid())
  userId     String
  name       String
  url        String
  storageKey String
  mimeType   String
  sizeBytes  Int
  mediaType  MediaType      @default(image)
  source     MaterialSource
  taskId     String?
  expiresAt  DateTime?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, expiresAt])
}

model GenerationTask {
  id             String            @id @default(uuid())
  userId         String
  type           GenerationType
  status         TaskStatus        @default(queued)
  provider       String            @default("gemini")
  model          String
  prompt         String
  negativePrompt String?
  parameters     Json
  providerJobId  String?
  errorCode      String?
  errorMessage   String?
  sessionId      String?
  sessionTitle   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets         GenerationAsset[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([userId, sessionId])
}

model GenerationAsset {
  id         String         @id @default(uuid())
  taskId     String
  role       AssetRole
  mediaType  MediaType
  url        String
  storageKey String
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime       @default(now())
  task       GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, role])
}

model ApiAuditLog {
  id         String   @id @default(uuid())
  userId     String?
  method     String
  path       String
  statusCode Int
  requestId  String
  details    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([path, createdAt])
  @@index([userId, createdAt])
}

// ============================================================
// TikTok 数据看板
// ============================================================

model SystemConfig {
  key        String   @id
  category   String
  isSecret   Boolean  @default(false)
  valuePlain String?
  valueEnc   Bytes?
  valueIv    Bytes?
  valueTag   Bytes?
  byteLength Int?
  updatedBy  String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([category])
}

model TiktokAccount {
  id           String              @id @default(uuid())
  ownerId      String

  // 入口字段（handle 或 uid 至少一个）
  handle       String?             @unique // @username（去掉 @ 前缀存储或带 @，统一在 service 层处理）
  uid          String?             @unique // TikTok 数字 userId（19 位）
  secUid       String?             // 抓取后回填，主键给 API 用

  // 抓取回填基本信息
  nickname     String?
  avatarUrl    String?
  bioSignature String?

  // 手动运营字段
  salesTag String?
  category String?
  region   String?
  note     String?

  // 公开聚合指标
  followerCount  Int    @default(0)
  followingCount Int    @default(0)
  heartCount     BigInt @default(0)
  videoCount     Int    @default(0)

  status           TiktokAccountStatus @default(active)
  lastScrapedAt    DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  owner  User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  videos TiktokVideo[]

  @@index([ownerId, createdAt])
  @@index([status, lastScrapedAt])
}

model TiktokVideo {
  id           String    @id @default(uuid())
  accountId    String
  videoId      String
  title        String?
  coverUrl     String?
  videoUrl     String?
  durationMs   Int       @default(0)
  publishedAt  DateTime?
  playCount    BigInt    @default(0)
  likeCount    BigInt    @default(0)
  commentCount BigInt    @default(0)
  shareCount   BigInt    @default(0)
  collectCount BigInt    @default(0)
  scrapedAt    DateTime  @default(now())

  account TiktokAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  metrics TiktokVideoMetric[]

  @@unique([accountId, videoId])
  @@index([accountId, publishedAt])
  @@index([accountId, playCount])
}

model TiktokVideoMetric {
  id           String   @id @default(uuid())
  videoId      String
  playCount    BigInt
  likeCount    BigInt
  commentCount BigInt
  shareCount   BigInt
  collectCount BigInt
  capturedAt   DateTime @default(now())

  video TiktokVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, capturedAt])
}
