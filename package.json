{
    "name":  "polloai-gemini-dual",
    "private":  true,
    "version":  "0.1.0",
    "description":  "Gemini dual-feature project: text-to-image and image-to-video",
    "packageManager":  "pnpm@10.6.3",
    "scripts":  {
                    "build":  "pnpm --filter @packages/shared build \u0026\u0026 pnpm -r --filter \"!@packages/shared\" build",
                    "dev":  "pnpm -r --parallel dev",
                    "dev:api":  "pnpm --filter @packages/shared build \u0026\u0026 pnpm --filter @apps/api dev",
                    "dev:worker":  "pnpm --filter @packages/shared build \u0026\u0026 pnpm --filter @apps/worker dev",
                    "dev:web":  "pnpm --filter @apps/web dev",
                    "test":  "pnpm -r test",
                    "db:generate":  "prisma generate",
                    "db:migrate":  "prisma migrate dev",
                    "db:push":  "prisma db push",
                    "db:seed":  "tsx prisma/seed.ts"
                },
    "devDependencies":  {
                            "prisma":  "^6.7.0",
                            "tsx":  "^4.19.3",
                            "typescript":  "^5.8.3"
                        },
    "dependencies":  {
                         "@prisma/client":  "6.19.2"
                     }
}
