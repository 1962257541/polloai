# 真实模式镜像：复用已构建的 mock 镜像(已装好全部 Python 依赖)，
# 增量补 Playwright 运行所需系统库 + 下载 chromium 浏览器二进制。
FROM doubao-video-2api-app:latest

# Playwright/chromium 运行依赖的系统库（参照标准 Dockerfile）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 \
    libxrandr2 libgbm1 libasound2 libatspi2.0-0 \
    libpango-1.0-0 libcairo2 \
    fonts-unifont fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# 下载与 playwright==1.44.0 匹配的 chromium
RUN playwright install chromium

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
