# /.env.example
# ====================================================================
# doubao-2api 配置文件模板
# ====================================================================
#
# 请将此文件重命名为 ".env" 并填入您的凭证。
#

# --- 核心安全配置 (必须设置) ---
# 用于保护您 API 服务的访问密钥。
API_MASTER_KEY=sk-doubao-2api-default-key-please-change-me

# --- 部署配置 (可选) ---
# Nginx 对外暴露的端口
NGINX_PORT=8088

# --- 豆包凭证 (必须设置) ---
# 请从浏览器开发者工具中获取完整的 Cookie 字符串。
# 登录 https://www.doubao.com/chat/ 后，按 F12 打开开发者工具，
# 切换到“网络(Network)”面板，随便发送一条消息，
# 在请求列表中找到 `completion` 请求，右键 -> 复制 -> 复制为 cURL (bash)，
# 然后从 cURL 命令中找到 `--cookie '...'` 部分，将其中的内容粘贴到下方。
#
# 支持多账号轮询，只需按格式添加 DOUBAO_COOKIE_2, DOUBAO_COOKIE_3, ...
DOUBAO_COOKIE_1="在此处粘贴您的完整 Cookie 字符串"

# --- 会话管理 (可选) ---
# 对话历史在内存中的缓存时间（秒），默认1小时
SESSION_CACHE_TTL=3600

# --- Doubao account pool ---
# Optional per-account controls. Missing values fall back to the defaults below.
# Weight controls weighted round-robin; max concurrency controls simultaneous leases per account.
DOUBAO_COOKIE_WEIGHT_1=1
DOUBAO_COOKIE_MAX_CONCURRENCY_1=1
DOUBAO_COOKIE_DISABLED_1=false
DOUBAO_ACCOUNT_DEFAULT_WEIGHT=1
DOUBAO_ACCOUNT_MAX_CONCURRENCY=1
# 0 means no global cap beyond per-account caps.
DOUBAO_ACCOUNT_GLOBAL_CONCURRENCY=0
DOUBAO_ACCOUNT_FAILURE_THRESHOLD=3
DOUBAO_ACCOUNT_COOLDOWN_SECONDS=300
DOUBAO_ACCOUNT_ACQUIRE_TIMEOUT=30

# --- Per-account browser profiles ---
# Each account gets a stable profile directory. Contexts open lazily and are
# persisted on idle eviction, account removal, or service shutdown.
DOUBAO_BROWSER_PROFILE_DIR=.generated/browser-profiles
DOUBAO_BROWSER_MAX_ACTIVE_CONTEXTS=15
DOUBAO_BROWSER_IDLE_TIMEOUT_SECONDS=120
DOUBAO_BROWSER_CLEANUP_INTERVAL_SECONDS=60
PERSONAL_BROWSER_HEADLESS=true
DOUBAO_BROWSER_LAZY_START=true
DOUBAO_BROWSER_IDLE_SHUTDOWN_SECONDS=45
DOUBAO_BROWSER_STALE_SESSION_SECONDS=300

# --- Doubao captcha auto solver ---
# Normal submissions, verification recovery, and result polling use independent queues.
DOUBAO_VIDEO_SUBMIT_CONCURRENCY=15
DOUBAO_FRONTEND_SUBMIT_CONCURRENCY=5
DOUBAO_FRONTEND_RESULT_WAIT_CONCURRENCY=20
DOUBAO_VERIFICATION_LIGHT_WAIT_SNAPSHOT_INTERVAL_SECONDS=30
# openai: call an OpenAI-compatible vision chat/completions API.
# zhenxun: import zhenxun.services.llm and use the same multimodal LLM flow as
# zhenxun-plugin-ai_creation.
# zhenxun_plugin: import the original plugin module and call its
# solve_drag_captcha_if_present(page) function directly.
# http_json: POST {"prompt","image_base64","image_mime"} to a custom endpoint
# that returns {"success": true, "indices": [1, 5, 8]}.
DOUBAO_CAPTCHA_AUTO_SOLVE=true
DOUBAO_CAPTCHA_SOLVER_BACKEND=openai
DOUBAO_CAPTCHA_SOLVER_BASE_URL=
DOUBAO_CAPTCHA_SOLVER_API_KEY=
DOUBAO_CAPTCHA_SOLVER_MODEL=
DOUBAO_CAPTCHA_ZHENXUN_MODEL=
# Optional semicolon-separated import roots if zhenxun is not installed in the
# current Python environment. For Docker, mount the path into the app container
# first, then point this to the mounted path.
DOUBAO_CAPTCHA_ZHENXUN_IMPORT_PATH=
DOUBAO_CAPTCHA_ZHENXUN_PLUGIN_MODULE=ai_creation.engines.doubao.captcha_solver
DOUBAO_CAPTCHA_SOLVER_TIMEOUT_SECONDS=45
DOUBAO_CAPTCHA_SOLVER_RETRIES=2

# --- Doubao quota tracking ---
# Default endpoint is captured from the doubao.com web frontend credit panel.
# The old /samantha/video/query_video_gen_info remain_count is not trusted by default.
DOUBAO_QUOTA_ENDPOINT=https://www.doubao.com/commerce/benefit_supply/credit/get_credit_num_optional_tasks
DOUBAO_QUOTA_METHOD=POST
DOUBAO_QUOTA_SIGNED=true
DOUBAO_QUOTA_REQUEST_BODY='{"need_tasks": false}'
# Optional dotted JSON paths for non-standard quota responses, e.g. data.balance.remain.
DOUBAO_QUOTA_TOTAL_PATH=
DOUBAO_QUOTA_REMAINING_PATH=
DOUBAO_QUOTA_USED_PATH=
DOUBAO_QUOTA_UNIT="video credits"
# Local estimated deduction after successful upstream calls. Real quota refresh reconciles these values.
DOUBAO_CHAT_QUOTA_COST=0
DOUBAO_VIDEO_QUOTA_COST=2

# --- Video generation API ---
# Submit video generation through the captured doubao.com chat/completion
# video ability request shape. Use VIDEO_PROVIDER=mock only for local tests.
VIDEO_PROVIDER=doubao_web
VIDEO_PUBLIC_BASE_URL=
VIDEO_RELATIVE_CONTENT_URLS=true
VIDEO_OUTPUT_DIR=.generated/videos
VIDEO_TASK_DELAY_SECONDS=0.25
VIDEO_TASK_RETENTION_SECONDS=3600
VIDEO_TASK_MAX_RETAINED=500
VIDEO_TASK_CLEANUP_INTERVAL_SECONDS=300
DEFAULT_VIDEO_MODEL=doubao-seedance-2-0
DOUBAO_VIDEO_WATERMARK=false
# Video request parameters follow the doubao.com web frontend abilityParams:
# model + ratio + duration + resolution + watermark.
# Built-in ratios: 16:9, 9:16, 1:1. Native upstream durations: 5, 10.
# 15s/20s/25s/30s are generated as multiple native clips and concatenated with ffmpeg.
VIDEO_LONG_FORM_ENABLED=true
VIDEO_LONG_FORM_MAX_DURATION_SECONDS=30
VIDEO_LONG_FORM_SEGMENT_SECONDS=10
VIDEO_LONG_FORM_CONCAT_TIMEOUT_SECONDS=600
DOUBAO_VIDEO_BOT_ID=7338286299411103781
DOUBAO_VIDEO_ABILITY_TYPE=17
DOUBAO_VIDEO_PC_VERSION=3.23.1
DOUBAO_VIDEO_ACCOUNT_RETRY_LIMIT=8
DOUBAO_VIDEO_VERIFICATION_RETRY_LIMIT=3
DOUBAO_VIDEO_TASK_TIMEOUT_SECONDS=900
DOUBAO_VIDEO_QUOTA_AUTO_REFRESH=true
DOUBAO_VIDEO_QUOTA_INITIAL_REFRESH=true
DOUBAO_VIDEO_QUOTA_REFRESH_CONCURRENCY=1
DOUBAO_VIDEO_QUOTA_REFRESH_INTERVAL_SECONDS=30
DOUBAO_VIDEO_QUOTA_REFRESH_BATCH_SIZE=1
DOUBAO_VIDEO_QUOTA_REFRESH_MIN_AVAILABLE_ACCOUNTS=3
DOUBAO_VIDEO_QUOTA_UNKNOWN_REFRESH_INTERVAL_SECONDS=600
DOUBAO_VIDEO_QUOTA_REFRESH_TIMEOUT_SECONDS=30
DOUBAO_VIDEO_QUOTA_HISTORY_CONVERSATIONS=50
DOUBAO_VIDEO_QUOTA_MAX_AGE_SECONDS=300
DOUBAO_VIDEO_ALLOW_UNKNOWN_QUOTA_ON_GENERATE=false
# Submit and poll inside the selected account's browser context.
DOUBAO_VIDEO_TRANSPORT=browser
DOUBAO_VIDEO_CHANNEL=bing_sem

# For video-only local testing, set this to false so the app does not require
# Doubao cookies/device fingerprint on startup.
ENABLE_CHAT_PROVIDER=true
